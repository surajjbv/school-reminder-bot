{
  "name": "school-reminder-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local, headless bot that turns school emails and teacher WhatsApp messages into a daily WhatsApp to-do digest",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bot.js",
    "login:google": "node --disable-warning=ExperimentalWarning login.js google",
    "login:whatsapp": "node --disable-warning=ExperimentalWarning login.js whatsapp",
    "schedule": "bash schedule.sh install",
    "test": "node --disable-warning=ExperimentalWarning --test test.js"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:wwebjs/whatsapp-web.js#58ddf1561cd783d6a548fa812eb70a05944604b4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "license": "MIT",
  "main": "bot.js",
  "puppeteer": {
    "skipDownload": true
  }
}
