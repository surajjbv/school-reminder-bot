# Copy to .env and fill in. .env is gitignored; never commit it.

# Google (your own Gmail, read-only). The refresh token is filled by `npm run login:google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Kid 1: school email / Google Classroom
EMAIL_KID_NAME=Anu
SCHOOL_ACCOUNT_EMAIL=anu@school.example.org
# Gmail search that finds this kid's school mail in YOUR inbox
SCHOOL_GMAIL_QUERY={to:anu@school.example.org from:school.example.org} -from:accounts.google.com

# Kid 2: teacher's WhatsApp chat (name exactly as saved in your contacts)
CHAT_KID_NAME=Ravi
TEACHER_CHAT_NAME=Class Teacher

# Output: WhatsApp group, and the member to @mention
GROUP_NAME=School Notification
MENTION_NAME=Partner
# Only if several contacts share that name: last digits of the right number
MENTION_NUMBER_ENDS_WITH=

# LM Studio model (reused if already loaded; otherwise loaded for the run, then unloaded)
MODEL=lmstudio-community/Qwen3.5-9B-MLX-4bit

# Daily send times (IST, comma separated)
RUN_TIMES=10:00

# Optional: script run-now.command runs first (e.g. quit other apps to free RAM)
QUIT_ALL_COMMAND=
# Optional: Chrome location if not in /Applications
CHROME_PATH=
