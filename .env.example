# Copy to .env and fill in. .env is gitignored; never commit it.

# Google, read-only. Run `npm run login:google` and sign in as the kid's school account (recommended)
# or as your own account if the school mail is forwarded to you. It fills the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Kid 1: school email + Google Classroom (read via the kid's Google account, see login:google)
EMAIL_KID_NAME=Anu
# Gmail search. Kid's own inbox: everything except Google account notices.
# Your inbox instead: {to:anu@school.example.org from:school.example.org}
SCHOOL_GMAIL_QUERY=-from:accounts.google.com

# Kid 2: teacher's WhatsApp chat (name exactly as saved in your contacts)
CHAT_KID_NAME=Ravi
TEACHER_CHAT_NAME=Class Teacher

# Output: WhatsApp group, and the member to @mention
GROUP_NAME=School Notification
MENTION_NAME=Partner
# Only if several contacts share that name: last digits of the right number
MENTION_NUMBER_ENDS_WITH=

# LM Studio model (reused if already loaded; otherwise loaded for the run, then unloaded)
MODEL=lmstudio-community/Qwen3.5-9B-MLX-4bit

# Daily run times (IST, comma separated). First message of the day = full list; later ones = only new tasks.
# How many days back the FIRST run reads (later runs read everything since the last run)
EMAIL_LOOKBACK_DAYS=14
WHATSAPP_LOOKBACK_DAYS=14

RUN_TIMES=10:00,20:00

# Optional: Chrome location if not in /Applications
CHROME_PATH=
