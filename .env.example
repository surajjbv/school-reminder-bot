# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Google (your own Gmail, read-only). Refresh token is filled by `npm run login:google` ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Kid 1: school email / Google Classroom ---
EMAIL_KID_NAME=Anu
# The kid's school Google account (used for Classroom attachments)
SCHOOL_ACCOUNT_EMAIL=anu@school.example.org
# Gmail search that finds this kid's school mail in YOUR inbox
SCHOOL_GMAIL_QUERY={to:anu@school.example.org from:school.example.org} -from:accounts.google.com

# --- Kid 2: teacher's WhatsApp messages ---
CHAT_KID_NAME=Ravi
# Chat name exactly as saved in your WhatsApp contacts
TEACHER_CHAT_NAME=Class Teacher

# --- Output: WhatsApp group, and the member to @mention ---
GROUP_NAME=School Notification
MENTION_NAME=Partner
# Only if several contacts share that name: last digits of the right number
MENTION_NUMBER_ENDS_WITH=

# --- Model (LM Studio) ---
MODEL=lmstudio-community/Qwen3.8-27B-MLX-4bit
# chatml-nothink: fast path for Qwen models (skips hidden reasoning, ~12x faster)
# chat: generic OpenAI-style chat, use for non-Qwen models
LLM_PROMPT_MODE=chatml-nothink
LLM_CONTEXT=16384
MIN_CONFIDENCE=0.5

# --- Schedule (IST, comma separated) ---
RUN_TIMES=10:00
# Days to look back on the very first run
FIRST_RUN_LOOKBACK_DAYS=14

CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: script run-now.command runs first (e.g. quit other apps to free RAM for the model)
QUIT_ALL_COMMAND=
